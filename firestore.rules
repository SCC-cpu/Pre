rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "ppomberl@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // CORRECCIÓN: Ahora valida directamente por el correo del cliente,
    // eliminando la lectura a la colección 'configuracion' que causaba el error internal.
    function isCustomer() {
      return signedIn()
        && request.auth.token.email == "colorado3oscar@gmail.com";
    }

    function validProduct(data) {
      return data.keys().hasAll(["name", "category", "tablePrice", "boxPrice"])
        && data.keys().hasOnly(["name", "category", "tablePrice", "boxPrice"])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.category in ["congelado", "fresco", "embutidos", "res", "pollo", "pescado"]
        && data.tablePrice is number
        && data.tablePrice >= 0
        && data.boxPrice is number
        && data.boxPrice >= 0;
    }

    match /productos/{productId} {
      allow read: if isAdmin() || isCustomer();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /configuracion/acceso {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
